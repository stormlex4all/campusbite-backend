# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- MongoDB ----
# Use a replica set (even a single-node one) to get multi-document transactions.
# Atlas works out of the box. A standalone mongod also works: the API then falls
# back to atomic conditional updates with compensation (see USE_TRANSACTIONS).
MONGODB_URI=mongodb://127.0.0.1:27017/campusbite
# MongoDB server used by `npm test`. Tests create and drop their own temporary databases on it
# (any database name here is ignored). Use a replica-set URI to also exercise transactions.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/
# auto | true | false
USE_TRANSACTIONS=auto

# ---- Auth ----
# REQUIRED in production (min 16 chars). 
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10
AUTH_RATE_LIMIT_MAX=10

# Students must register with one of these domains (comma separated)
SCHOOL_EMAIL_DOMAINS=rdpolytech.ca

# ---- Clients ----
# Origins allowed by CORS (React dev server, Expo web, ...). Native apps do not use CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Optional: path to the React production build; when set (and the folder exists) the API also serves it
# CLIENT_BUILD_DIR=../campusbite-web/dist

# ---- Image uploads (menu item photos) ----
# Photos are stored on local disk and served from /uploads. For production, mount a persistent disk here
# (or swap in cloud storage: see src/storage/StorageFactory.js).
UPLOAD_DIR=./uploads
MAX_IMAGE_MB=2
MAX_IMAGES_PER_ITEM=4

# ---- Logging ----
LOG_LEVEL=info

# ---- Seed script ----
ADMIN_NAME=CampusBite Admin
ADMIN_EMAIL=admin@campusbite.local
ADMIN_PASSWORD=admin123!
